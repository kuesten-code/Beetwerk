# Beetwerk – Konfiguration. Kopieren nach .env und anpassen.

# --- Netzwerk ---------------------------------------------------------------
# Adresse und Port auf dem Host. 127.0.0.1 = nur für den Reverse Proxy erreichbar.
BIND_ADDRESS=127.0.0.1
PORT=8080
# Öffentliche Adresse hinter dem Reverse Proxy, z. B. https://garten.example.de
# Mit http:// (außer localhost) wird Push automatisch abgeschaltet.
PUBLIC_URL=
# X-Forwarded-*-Header vom Reverse Proxy übernehmen (echte Client-IP, HTTPS-Erkennung).
TRUST_FORWARDED_HEADERS=true

# Image-Version für `docker compose pull` (Standard: latest), z. B. 0.2.0
BEETWERK_VERSION=latest

# UID/GID, unter der der Container läuft – muss ./data beschreiben dürfen (siehe `id -u`, `id -g`).
BEETWERK_UID=1000
BEETWERK_GID=1000

# --- Anmeldung --------------------------------------------------------------
# login (Standard) oder none (nur in vertrauenswürdigen Netzen!)
AUTH_MODE=login
# Wird beim ersten Start angelegt, falls es den Nutzer noch nicht gibt (min. 8 Zeichen).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# AUTH_MODE=none zusammen mit PUBLIC_URL verweigert den Start – außer hiermit ausdrücklich erlaubt.
AUTH_ALLOW_NONE_PUBLIC=false

# --- Push-Benachrichtigungen ------------------------------------------------
PUSH_ENABLED=true
# Leer lassen = Schlüssel werden beim ersten Start erzeugt und in data/keys/vapid.json gespeichert.
# Eigene Schlüssel erzeugen: docker compose run --rm beetwerk vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.de
# Ab dieser Stunde (Ortszeit) werden fällige Aufgaben gemeldet.
NOTIFY_HOUR=8
TZ=Europe/Berlin

# --- Karte ------------------------------------------------------------------
# Primärquelle: Orthofotos (DOP20) Schleswig-Holstein, CC BY 4.0. Für andere Bundesländer anpassen.
# Platzhalter: {z}/{x}/{y} für XYZ-Kacheln oder {bbox-epsg-3857} für WMS.
MAP_PRIMARY_URL=
MAP_PRIMARY_ATTRIBUTION=
MAP_PRIMARY_MAXZOOM=21
# Fallback unterhalb der Primärquelle (Standard: Esri World Imagery). "none" schaltet ihn ab.
MAP_FALLBACK_URL=
MAP_FALLBACK_ATTRIBUTION=
MAP_FALLBACK_MAXZOOM=19
